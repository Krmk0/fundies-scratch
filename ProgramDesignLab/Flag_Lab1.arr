use context starter2024

# We create the flag
above(rectangle(200, 50, "solid", "green"),
  above(rectangle(200, 50, "solid", "yellow"), (rectangle(200, 50, "solid", "red"))))


# Shield

overlay(star(25, "solid", "green"), overlay(rotate(45, square(100, "solid", "yellow")), rotate(45, square(110, "solid", "orange"))))